# Environment Configuration Example
# Copy this file to .env.local and modify as needed.
# Vite only exposes vars prefixed with VITE_ to the bundle.

# API Configuration (consumed in src/config/api.ts)
VITE_API_URL=http://localhost:8082/api

# Mock API Toggle
# Set to 'true' to use mock data, 'false' to use real backend
VITE_USE_MOCK_API=true

# Other configurations
VITE_BASE_PATH=/
VITE_TEMPO=false
