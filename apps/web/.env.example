# Fallback only. The site first reads /config.json at run time (public/config.example.json); these apply when that file has no value.
# Placeholders only. Copy to .env.local (untracked). Vite exposes VITE_ values to the browser,
# so never put a secret here.
# The salon function URL (apps/salon-function), for example the DigitalOcean web function URL.
VITE_SALON_URL=https://salon-function.example.com/salon
# The POS online booking page (the book station).
VITE_BOOKING_URL=https://book.example.com
